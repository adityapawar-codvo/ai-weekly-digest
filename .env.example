# OpenRouter API — free tier available at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
OPENROUTER_MODEL=openrouter/auto

# Brevo transactional email API — get key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your-api-key-here
SENDER_EMAIL=your-verified-sender@example.com
SENDER_NAME=AI Weekly Digest

# Email address that receives previews and failure alerts
MAINTAINER_EMAIL=maintainer@example.com

# If true, EVERY send (preview + full) only goes to MAINTAINER_EMAIL.
# Keep this true while testing; set to false only when ready to send to the full list.
DRY_RUN=true
